# # Base URL for the WebSentinal backend API.
# # Leave as /api in development to use the Vite dev-server proxy (see vite.config.js).
# # In production, set this to your full backend origin, e.g. https://api.example.com/api
VITE_API_URL=/api

# # Backend origin used for OAuth redirects (must be the absolute origin, no /api).
# # In production, set this to your full backend host, e.g. https://api.example.com
VITE_API_ORIGIN=http://localhost:3000


//for vercel deployment
# VITE_API_URL=https://websentinal-2-0-2.onrender.com/api
# VITE_API_ORIGIN=https://websentinal-2-0-2.onrender.com